[Unit]
Description=Paperclip Impact Gate Polling Worker (daemon mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/sirrus/miniconda3/bin/python3 /home/sirrus/projects/BTC-Trade-Engine-PaperClip/scripts/run_impact_gate_polling_worker.py --daemon --lookback-minutes 10 --poll-interval 300
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=5
Environment=HOME=/home/sirrus
Environment=PYTHONPATH=/home/sirrus/projects/BTC-Trade-Engine-PaperClip/src
WorkingDirectory=/home/sirrus/projects/BTC-Trade-Engine-PaperClip
# Explicit PAPERCLIP_* vars — do NOT use EnvironmentFile=.env here.
# See paperclip-backup-deadman-monitor.service for rationale.
# Script calls load_dotenv(override=False) for remaining vars (POSTGRES_*, GH_TOKEN).
Environment=PAPERCLIP_LISTEN_HOST=127.0.0.1
Environment=PAPERCLIP_LISTEN_PORT=3100
Environment=PAPERCLIP_API_KEY=local_trusted
Environment=PAPERCLIP_COMPANY_ID=73419cf3-bd37-4a7c-8782-311ccb47fced

[Install]
WantedBy=default.target
