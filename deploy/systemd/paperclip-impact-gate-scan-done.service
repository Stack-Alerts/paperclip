[Unit]
Description=Paperclip Impact Gate Scan-Done (5-min polling daemon — full gate)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/sirrus/projects/BTC-Trade-Engine-PaperClip/scripts/run_impact_gate_polling_daemon.sh --initial-scan
StandardOutput=journal
StandardError=journal
StandardInput=null
Environment=HOME=/home/sirrus
Environment=PATH=/home/sirrus/miniconda3/bin:/usr/local/bin:/usr/bin:/bin:/home/sirrus/.local/bin
WorkingDirectory=/home/sirrus/projects/BTC-Trade-Engine-PaperClip
# Explicit PAPERCLIP_* vars — do NOT use EnvironmentFile=.env here.
# See paperclip-backup-deadman-monitor.service for rationale.
Environment=PAPERCLIP_LISTEN_HOST=127.0.0.1
Environment=PAPERCLIP_LISTEN_PORT=3100
Environment=PAPERCLIP_API_KEY=local_trusted
Environment=PAPERCLIP_COMPANY_ID=73419cf3-bd37-4a7c-8782-311ccb47fced

[Install]
WantedBy=default.target
