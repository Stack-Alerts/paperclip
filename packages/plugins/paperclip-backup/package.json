{
  "name": "paperclip-backup",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Paperclip Backup & Restore plugin — offsite (rclone → Google Drive) and local DB dump management surfaced in the Paperclip UI.",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "backup",
    "rclone",
    "gdrive",
    "disaster-recovery"
  ],
  "author": "Stack-Alerts",
  "license": "MIT",
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && node ./esbuild.config.mjs && tsc --emitDeclarationOnly --outDir dist",
    "build:ui": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "clean": "rm -rf dist",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
